# {{ ansible_managed }}
#
# Mode 0600, and never committed. Everything here arrives from the secret store
# at run time.

PG_USER={{ authentik_postgres_user }}
PG_DB={{ authentik_postgres_db }}
PG_PASS={{ authentik_postgres_password }}

AUTHENTIK_POSTGRESQL__HOST=postgresql
AUTHENTIK_POSTGRESQL__USER={{ authentik_postgres_user }}
AUTHENTIK_POSTGRESQL__NAME={{ authentik_postgres_db }}
AUTHENTIK_POSTGRESQL__PASSWORD={{ authentik_postgres_password }}

AUTHENTIK_REDIS__HOST=redis

# Signing key for sessions and tokens. Rotating it logs everybody out, which
# is occasionally what you want and never what you want by accident.
AUTHENTIK_SECRET_KEY={{ authentik_secret_key }}

# ── bootstrap ───────────────────────────────────────────────────────────────
#
# These two are what make the deployment zero-touch, and they are read only on
# first start — once the built-in admin exists, changing them here does
# nothing. That is worth knowing before spending an afternoon on it.
#
# The token is the important one: it gives terraform/identity an authenticated
# path in without anyone opening the web interface to complete a wizard and
# mint a token by hand.
AUTHENTIK_BOOTSTRAP_PASSWORD={{ authentik_bootstrap_password }}
AUTHENTIK_BOOTSTRAP_TOKEN={{ authentik_bootstrap_token }}

# Error reporting off. This is an identity provider; its stack traces contain
# the shape of the estate, and they are not this project's to send anywhere.
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_DISABLE_UPDATE_CHECK=true
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true

AUTHENTIK_LOG_LEVEL=info
